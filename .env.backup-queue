APP_NAME=Worksuite
APP_KEY=base64:nhuGiRYQe6Dq3+GFiu/L45Clgj26J/h/6d33Z1rPOB0=

# Do not change APP_ENV to anything else. It will affect emailing from admin panel
# and other configuration from databse and system may crash
APP_ENV=development
APP_DEBUG=true

# Diagnostic de performance : journalise temps de reponse et requetes SQL
# dans storage/logs/perf-*.log. A laisser sur false en exploitation normale.
PERF_LOG=true

APP_URL=http://crm.test

#For redirect to https
REDIRECT_HTTPS=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow_bd_new
DB_USERNAME=root
DB_PASSWORD=

# Les notifications partent en arriere-plan au lieu de bloquer la requete.
# Sans cela (valeur par defaut 'sync'), creer une diligence notifiant
# 4 personnes fige l'ecran ~40 s, le temps des echanges avec le serveur mail.
# Necessite un processus : php artisan queue:work
QUEUE_CONNECTION=database

# ATTENTION - ce poste envoie par le VRAI serveur de production, vers les
# vraies adresses des collaborateurs et des clients. Aucune redirection
# n'est active (voir le garde-fou plus bas).
#
# Ces valeurs priment sur le SMTP stocke en base grace a APP_ENV=development,
# qui empeche SmtpConfigProvider et CustomConfigProvider de les ecraser.
# Le mot de passe en base est chiffre avec l'APP_KEY du serveur, illisible ici.
MAIL_MAILER=smtp
MAIL_HOST=mail.dc-knowing.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=info.taskflow@dc-knowing.com
MAIL_PASSWORD="Task@1234567"

# GARDE-FOU DESACTIVE le 27/08/2026 a la demande de l'utilisateur.
# En l'etat, ce poste se comporte comme la production : chaque tache ou
# diligence creee ici envoie de vrais mails aux collaborateurs et aux clients.
# Reactiver la ligne ci-dessous pour que tout aboutisse a cette seule adresse.
